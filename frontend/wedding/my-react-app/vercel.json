{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://wedding-book.onrender.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://wedding-book.onrender.com/admin/:path*"
    },
    {
      "source": "/django-admin",
      "destination": "https://wedding-book.onrender.com/django-admin/"
    },
    {
      "source": "/django-admin/:path*",
      "destination": "https://wedding-book.onrender.com/django-admin/:path*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://wedding-book.onrender.com/api/:match*"
    },
    {
      "source": "/static/:match*",
      "destination": "https://wedding-book.onrender.com/static/:match*"
    },
    {
      "source": "/media/:match*",
      "destination": "https://wedding-book.onrender.com/media/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}