{
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "https://wedding-book.onrender.com/admin/:path*"
    },
    {
      "source": "/django-admin/:path*",
      "destination": "https://wedding-book.onrender.com/django-admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://wedding-book.onrender.com/static/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://wedding-book.onrender.com/media/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://wedding-book.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}